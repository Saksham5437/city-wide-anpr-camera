# API Server Configuration
API_V1_STR=/api
PROJECT_NAME="City-Wide ANPR Command & Control Platform"
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# MySQL 8.x Database Connection
# Format: mysql+pymysql://username:password@localhost:3306/city_anpr
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/city_anpr

# Fallback SQLite connection for zero-config local testing:
# DATABASE_URL=sqlite:///./anpr.db

# JWT Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Evidence / Image Storage Path
STORAGE_PATH=./storage

# ANPR & Detection Pipeline Configuration
ANPR_CONFIDENCE_THRESHOLD=85.0
DUPLICATE_WINDOW_SECONDS=5
ANPR_SPEED_LIMIT_THRESHOLD=80
ANPR_MODEL_DEVICE=cpu
