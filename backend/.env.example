# API Server Configuration
API_V1_STR=/api
PROJECT_NAME="City-Wide ANPR Command & Control Platform"
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# PostgreSQL Database Connection
# Format: postgresql://username:password@localhost:5432/anpr_db
# For lightweight local SQLite fallback when testing: sqlite:///./anpr.db
DATABASE_URL=sqlite:///./anpr.db

# JWT Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ANPR Service Configuration
ANPR_SPEED_LIMIT_THRESHOLD=80
ANPR_MODEL_DEVICE=cpu
