# JWT Security
SECRET_KEY=jNFYfmHom7vUj+4ycs50lh4bHemHlyK7rVDp3nSyqZc3+/k2s2QtViyrTO6hUlmEK8i++KpdsZ6HxPXtX8Ll3g==
