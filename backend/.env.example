# API Server Configuration
API_V1_STR=/api
PROJECT_NAME="City-Wide ANPR Command & Control Platform"
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Local MySQL 8.x Database Connection (for MySQL Workbench & Local MySQL Server)
# Format: mysql+pymysql://<USERNAME>:<PASSWORD>@127.0.0.1:3306/city_anpr?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:Sakre5437@127.0.0.1:3306/city_anpr?charset=utf8mb4

# JWT Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Evidence / Image Storage Path
STORAGE_PATH=./storage

# ANPR & Detection Pipeline Configuration
ANPR_CONFIDENCE_THRESHOLD=85.0
DUPLICATE_WINDOW_SECONDS=5
ANPR_SPEED_LIMIT_THRESHOLD=80
ANPR_MODEL_DEVICE=cpu
